<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <!-- The RefurbishedDinosaurs.* runtime packages release together and are pinned exactly. Every
         project that references one uses this version, so a bump is one edit. -->
    <RefurbishedDinosaursVersion>6.2.0</RefurbishedDinosaursVersion>
  </PropertyGroup>
</Project>
